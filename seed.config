CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# PassWall2, AdGuardHome, Tailscale, ModemManager are deferred to a
# post-firstboot local install from bin/packages/ (see
# files/etc/uci-defaults/95-install-deferred-packages.sh) instead of being
# baked into the base squashfs image, to keep it under the device's 60MB
# rootfs partition. Their packages still get *compiled* here (selected in
# seed.config, which produces this VM's cached staging_dir/build_dir) but
# are explicitly excluded from this slim image profile.
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_adguardhome=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_tailscale=n
CONFIG_PACKAGE_luci-app-tailscale=n
CONFIG_PACKAGE_modemmanager=n
CONFIG_PACKAGE_luci-proto-modemmanager=n
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=n
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=n
CONFIG_PACKAGE_kmod-usb-serial-option=n
CONFIG_PACKAGE_usb-modeswitch=n

# passwall2 needs ip-full (base image otherwise defaults to ip-tiny, which
# conflicts with ip-full at install time)
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-tiny=n

# iStore (needs xz-utils or its LIBCURL/TAR_XZ dependency check silently disables it)
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_xz-utils=y

# OpenVPN (server GUI + client-as-interface protocol with a plain on/off
# toggle in Network > Interfaces -- immortalwrt/luci has no dedicated
# "client" app, this is the standard way to get client mode with a GUI switch)
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn-server=y
CONFIG_PACKAGE_luci-proto-openvpn=y

# SQM (NSS-compatible fork)
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y

# USB3 host controller + external storage
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_luci-app-diskman=y

# Python (light variant, feed default version)
CONFIG_PACKAGE_python3-light=y

# TCP BBR
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Admin/monitoring conveniences
# (opkg/software management is already in base luci; no separate luci-app-opkg package exists)
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

CONFIG_LUCI_LANG_zh_Hans=y
