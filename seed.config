CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# PassWall2, AdGuardHome, Tailscale, ModemManager are deferred to a
# post-firstboot local install from bin/packages/ (see
# files/root/install-deferred-packages.sh) instead of being baked into the
# base squashfs image, to keep it under the device's 60MB rootfs partition.
# =m (not =n!) is required here: =n skips compiling/packaging entirely, =m
# builds and packages it into bin/packages/ but leaves it out of the base
# image -- exactly the "deferred" behavior we want.
CONFIG_PACKAGE_luci-app-passwall2=m
CONFIG_PACKAGE_adguardhome=m
CONFIG_PACKAGE_luci-app-adguardhome=m
CONFIG_PACKAGE_tailscale=m
CONFIG_PACKAGE_luci-app-tailscale=m
CONFIG_PACKAGE_modemmanager=m
CONFIG_PACKAGE_luci-proto-modemmanager=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-serial-option=m
CONFIG_PACKAGE_usb-modeswitch=m

# shadowsocksr-libev fails to build; passwall2 selects it by default
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=n

# passwall2 needs ip-full (base image otherwise defaults to ip-tiny, which
# conflicts with ip-full at install time)
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-tiny=n

# iStore (needs xz-utils or its LIBCURL/TAR_XZ dependency check silently disables it)
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_xz-utils=y

# OpenVPN. This build's openvpn-openssl package ships no /etc/init.d/openvpn
# (modern OpenWrt manages it via netifd's proto=openvpn instead), but that
# netifd path doesn't reliably win the default route against an existing wan
# default (confirmed: route shows in `ubus call network.interface.<x> status`
# but never lands in the kernel table -- matches openwrt/netifd's own known
# "route present in netifd but missing from routing table" class of bugs),
# which makes it unsuitable for a "VPN changes my outbound IP" client. So:
# files/etc/init.d/openvpn + files/lib/functions/openvpn.sh (vendored from
# openwrt/packages, pre-netifd-migration) restore the classic procd
# multi-instance init script, and luci-app-openvpn (below, deferred, pulled
# in diy-jdc.sh since upstream luci dropped it after openwrt-23.05) gives it
# the classic combined client+server GUI page instead of Network>Interfaces.
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn-server=y
CONFIG_PACKAGE_luci-proto-openvpn=y
CONFIG_PACKAGE_luci-app-openvpn=m

# LZO/compression-stub support: without it, this build rejects ANY comp-lzo/
# compress directive outright (even "no"), which breaks connecting to legacy
# (pre-2.4, net30 topology) OpenVPN servers that use compression framing on
# the wire by default even when not explicitly pushing a comp-lzo/compress
# config line -- symptom is "write to TUN/TAP: Invalid argument (fd=-1)"
# roughly every `ping N` seconds after connecting (matches openwrt/packages#28957)
CONFIG_OPENVPN_openssl_ENABLE_LZO=y

# UPnP (nftables variant, matches this build's firewall4/nftables backend)
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y

# tailscaled manages its own iptables-nft-compat rules for exit-node/subnet-
# router NAT and connmark; needs the full legacy xtables extension set,
# firewall4's native nftables kmods alone aren't enough
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-conntrack-label=y
CONFIG_PACKAGE_kmod-nf-conncount=y

# SQM (NSS-compatible fork)
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y

# USB3 host controller + external storage
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_luci-app-diskman=y

# Python (light variant, feed default version)
CONFIG_PACKAGE_python3-light=y

# TCP BBR
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Admin/monitoring conveniences
# (opkg/software management is already in base luci; no separate luci-app-opkg package exists)
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

CONFIG_LUCI_LANG_zh_Hans=y
