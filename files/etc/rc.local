# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

echo schedutil > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null
echo 2048 > /sys/block/mmcblk0/queue/read_ahead_kb 2>/dev/null
echo 2048 > /sys/block/sda/queue/read_ahead_kb 2>/dev/null

# Set permanent multicast router port (2) on LAN switch ports to ensure uninhibited DLNA SSDP forwarding
for p in /sys/class/net/br-lan/brif/*; do
    [ -f "$p/multicast_router" ] && echo 2 > "$p/multicast_router" 2>/dev/null
done

# Ensure game_dscp_table exists in nftables
if ! nft list table inet game_dscp_table >/dev/null 2>&1; then
    /etc/init.d/game_dscp start 2>/dev/null || true
fi

exit 0
