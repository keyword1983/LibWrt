config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '1'
	option auto_mount '1'
	option delay_root '5'
	option check_fs '0'

config mount
	option target '/mnt/sda2'
	option device '/dev/sda2'
	option enabled '1'
	option fstype 'ntfs3'
	option options 'rw,noatime,iocharset=utf8,uid=0,gid=0,umask=0000'

config swap
	option device '/swapfile'
	option enabled '1'
